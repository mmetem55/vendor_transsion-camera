<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@anim/interpolator_common" android:ordering="sequentially"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <set>
        <objectAnimator android:duration="60" android:valueFrom="1.0" android:valueTo="0.8" android:valueType="floatType" android:propertyName="scaleX" />
        <objectAnimator android:duration="60" android:valueFrom="1.0" android:valueTo="0.8" android:valueType="floatType" android:propertyName="scaleY" />
    </set>
    <set>
        <objectAnimator android:duration="60" android:startOffset="100" android:valueFrom="0.8" android:valueTo="1.0" android:valueType="floatType" android:propertyName="scaleX" />
        <objectAnimator android:duration="60" android:startOffset="100" android:valueFrom="0.8" android:valueTo="1.0" android:valueType="floatType" android:propertyName="scaleY" />
    </set>
</set>

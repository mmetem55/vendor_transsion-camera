<?xml version="1.0" encoding="utf-8"?>
<set android:ordering="together"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <set android:interpolator="@anim/interpolator_cover_scale_start" android:ordering="together">
        <objectAnimator android:duration="150" android:valueFrom="1" android:valueTo="0.95" android:propertyName="scaleX" />
        <objectAnimator android:duration="150" android:valueFrom="1" android:valueTo="0.95" android:propertyName="scaleY" />
    </set>
    <set android:interpolator="@anim/interpolator_cover_filp" android:ordering="sequentially">
        <objectAnimator android:duration="250" android:startOffset="100" android:valueFrom="0.95" android:valueTo="-0.95" android:propertyName="scaleX" />
    </set>
    <set android:interpolator="@anim/interpolator_cover_scale_end" android:ordering="together">
        <objectAnimator android:duration="100" android:startOffset="340" android:valueFrom="-0.95" android:valueTo="-1" android:propertyName="scaleX" />
        <objectAnimator android:duration="100" android:startOffset="290" android:valueFrom="0.95" android:valueTo="1" android:propertyName="scaleY" />
    </set>
</set>

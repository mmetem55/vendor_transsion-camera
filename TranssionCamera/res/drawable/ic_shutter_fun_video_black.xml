<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:id="@id/state_pressed" android:drawable="@drawable/shutter_button_fun_video_pressed_black" />
    <item android:id="@id/state_normal" android:drawable="@drawable/shutter_button_fun_video_normal_black" />
    <transition android:drawable="@drawable/shutter_fun_video_normal_to_pressed_black" android:toId="@id/state_pressed" android:fromId="@id/state_normal" />
    <transition android:drawable="@drawable/shutter_fun_video_pressed_to_normal_black" android:toId="@id/state_normal" android:fromId="@id/state_pressed" />
</animated-selector>

<?xml version="1.0" encoding="utf-8"?>
<objectAnimator android:interpolator="@anim/interpolator_new" android:duration="@integer/super_night_capture_progress_duration"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt">
    <propertyValuesHolder android:valueFrom="0" android:valueTo="1" android:valueType="floatType" android:propertyName="trimPathEnd">
        <keyframe android:value="0" android:fraction="0.0" />
        <keyframe android:value="1" android:fraction="0.9" />
        <keyframe android:value="1" android:fraction="1.0" />
    </propertyValuesHolder>
    <propertyValuesHolder android:valueType="floatType" android:propertyName="strokeAlpha">
        <keyframe android:value="0" android:fraction="0.0" />
        <keyframe android:value="1" android:fraction="0.05" />
        <keyframe android:value="1" android:fraction="0.99" />
        <keyframe android:value="0" android:fraction="1.0" />
    </propertyValuesHolder>
</objectAnimator>

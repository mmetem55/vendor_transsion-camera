<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:id="@id/checked" android:drawable="@drawable/svg_radio_on" />
    <item android:id="@id/unchecked" android:drawable="@drawable/svg_radio_off" />
    <transition android:drawable="@drawable/svg_radio_on_to_off" android:toId="@id/unchecked" android:fromId="@id/checked" />
    <transition android:drawable="@drawable/svg_radio_off_to_on" android:toId="@id/checked" android:fromId="@id/unchecked" />
</animated-selector>
